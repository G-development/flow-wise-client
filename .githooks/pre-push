#!/bin/sh
# Controlli prima del push — Flow-Wise client
#
# Esegue i test e rifiuta il push se falliscono. Non c'e' piu' un'approvazione per SHA:
# la decisione di pubblicare spetta a Gio, e l'agente fa push solo dopo il suo ok
# esplicito in conversazione.
set -u

repo=$(git rev-parse --show-toplevel)
cd "$repo" || exit 1

fail() {
  echo "[pre-push] CHECK FALLITO: $1 — push rifiutato."
  exit 1
}

# Un solo `npm test` copre i tre passi richiesti, nell'ordine, e si ferma al primo
# che fallisce (catena `&&` nel comando):
#   node --test       -> invarianti unit (type stripping nativo di Node, nessun JSX)
#   npx tsc --noEmit  -> typecheck
#   next build        -> build + lint di Next (un errore di lint fa fallire il build)
# Parte da `rm -rf .next` perché i tipi generati obsoleti di `.next/types` fanno
# fallire `next build` su un albero sorgente corretto (falsi rossi quando una route
# viene rimossa o rinominata). Una sola build: nessun passo duplicato da tenere allineato.
echo "[pre-push] npm test (node --test && npx tsc --noEmit && next build)"
npm test || fail "test client (node --test / tsc --noEmit / next build)"

echo "[pre-push] check superati: push consentito."
exit 0
